#!/usr/bin/python
import subprocess
import json
import sys

def launch_hotspot(ssid, password, ifname):
    # Form the command to launch the Wi-Fi hotspot
    cmd = ['sudo', 'iwconfig', ifname, 'mode', 'Master', 'essid', ssid, 'key', password]

    # Execute the command and capture the output
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = proc.communicate()

    # Check if the hotspot was launched successfully
    if err:
        return json.dumps({"Success": False, "Message": err.decode()})
    else:
        return json.dumps({"Success": True, "Message": out.decode()})

# Read the ssid, password, and ifname from the command line arguments
ssid = sys.argv[1]
password = sys.argv[2]
ifname = sys.argv[3]

# Call the launch_hotspot function and print the result
result = launch_hotspot(ssid, password, ifname)
print(result)