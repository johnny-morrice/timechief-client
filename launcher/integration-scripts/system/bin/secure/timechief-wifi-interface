#!/usr/bin/python
import subprocess
import json
import sys
import re

def get_ip_address(interface):
    ip_address = ""
    try:
        ip_addr_output = subprocess.check_output(['nmcli', '-g', 'IP4.ADDRESS', 'device', 'show', interface]).decode()
        ip_address = ip_addr_output.strip().split('/')[0]  # Get IP address without CIDR notation
    except subprocess.CalledProcessError:
        pass
    return ip_address

def get_device_state(interface):
    try:
        state_output = subprocess.check_output(['nmcli', '-t', '-f', 'GENERAL.STATE', 'device', 'show', interface]).decode()
        state = state_output.split(':')[1].strip()  # Extract state value
    except subprocess.CalledProcessError:
        state = "Unknown"
    return state

def get_ssid(interface):
    ssid = ""
    try:
        ssid_output = subprocess.check_output(['nmcli', '-g', 'GENERAL.CONNECTION', 'device', 'show', interface]).decode()
        ssid = ssid_output.strip()
    except subprocess.CalledProcessError:
        pass
    return ssid

def get_mode(interface):
    mode = ""
    try:
        connection_name = get_ssid(interface)
        mode_output = subprocess.check_output(['nmcli', '-g', '802-11-wireless.mode', 'connection', 'show', connection_name]).decode().strip()
        mode = mode_output.strip()
    except subprocess.CalledProcessError:
        pass
    return mode

# Get the device name from the command-line argument
device_name = sys.argv[1]

# Get device state, SSID, mode, and IP address using nmcli
state = get_device_state(device_name)
ssid = get_ssid(device_name)
mode = get_mode(device_name)
ip_address = get_ip_address(device_name)

# Create a dictionary of the device information
device_info = {
    'Device': device_name,
    'State': state,
    'SSID': ssid,
    'Mode': mode,
    'IPV4Address': ip_address
}

# Print the dictionary as a JSON object
print(json.dumps(device_info, indent=4))
