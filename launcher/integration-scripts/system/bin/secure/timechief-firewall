#!/usr/bin/python
import sys
import subprocess
import argparse

def validate_ports(ports):
    """Validate each port to ensure it's an integer within the valid range."""
    for port in ports:
        try:
            port = int(port)
            if port < 0 or port > 65535:
                raise Exception(f"port {port} is out of the valid range (1-65535)")
        except ValueError:
            raise Exception(f"port '{port}' is not a valid integer")

def configure_firewall(captive_iface, port_text):
    ports = []
    if len(port_text) != 0:
        # Validate the ports
        ports = [port.strip() for port in port_text.split(',')]
        validate_ports(ports)

    # Define the base nftables configuration template
    nftables_config = """
#!/usr/sbin/nft -f

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        # Allow traffic on the loopback interface
        iif "lo" accept

        # Allow established and related connections
        ct state established,related accept
        
        # Allow DNS and DHCP
        tcp dport 53 accept
        udp dport 53 accept
        udp dport 67 accept
"""

    # Add rules for each port to allow traffic
    for port in ports:
        nftables_config += f"        tcp dport {port} accept\n"
        nftables_config += f"        udp dport {port} accept\n"

    # Close the input chain and add forward/output chains with default policies
    nftables_config += """
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
"""

    if captive_iface:
        nftables_config += f"""
table ip nat {{
    chain prerouting {{
        type nat hook prerouting priority -100; policy accept;
        iifname "{captive_iface}" tcp dport {{80,443}} redirect to 80
    }}
}}
    """
    
    # Write the configuration to /etc/nftables.conf
    with open('/etc/nftables.conf', 'w') as f:
        f.write(nftables_config)
    
    # Restart the nftables service to activate changes
    subprocess.run(['systemctl', 'restart', 'nftables'], check=True)

if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument('--captive', metavar='IFACE', help='Enable captive portal NAT on interface')
    parser.add_argument('ports', nargs='?', default='', help='Comma-separated ports to allow inbound')
    args = parser.parse_args()

    configure_firewall(args.captive, args.ports)
