#!/usr/bin/python
import sys
import subprocess

def configure_firewall(ports):
    # Convert the comma-separated ports list into a set of individual ports
    ports = [port.strip() for port in ports.split(',')]

    # Define the base nftables configuration template
    nftables_config = """
table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;
        iif "lo" accept
        ct state established,related accept
"""

    # Add rules for each port to the nftables configuration
    for port in ports:
        nftables_config += f"        tcp dport {port} accept\n"
        nftables_config += f"        udp dport {port} accept\n"

    # Close the chain
    nftables_config += "    }\n}\n"

    # Write the configuration to /etc/nftables.conf
    with open('/etc/nftables.conf', 'w') as f:
        f.write(nftables_config)

    # Apply the configuration immediately
    subprocess.run(['nft', '-f', '/etc/nftables.conf'], check=True)

    # Reload the systemd service to ensure persistence
    subprocess.run(['systemctl', 'enable', 'nftables'], check=True)
    subprocess.run(['systemctl', 'start', 'nftables'], check=True)

if __name__ == "__main__":
    if len(sys.argv) != 2:
        print("Usage: python3 set_firewall.py <port1,port2,...>")
        sys.exit(1)

    configure_firewall(sys.argv[1])