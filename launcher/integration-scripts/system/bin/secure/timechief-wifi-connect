#!/bin/bash
set -e
set -x

SSID=$1
PASSWORD=$2
IFNAME=$3

if [ -z "$SSID" ]; then
    echo "SSID is required"
    exit 1
fi

if [ -z "$PASSWORD" ]; then
    echo "PASSWORD is required"
    exit 1
fi

if [ -z "$IFNAME" ]; then
    echo "IFNAME is required"
    exit 1
fi

# Stop services that may conflict with Wi-Fi connection
systemctl stop hostapd
systemctl stop dnsmasq
systemctl stop systemd-networkd

# Generate wpa_supplicant configuration file
wpa_passphrase "$SSID" "$PASSWORD" > /etc/wpa_supplicant/wpa_supplicant-$IFNAME.conf

# Create systemd service to handle wpa_supplicant for the interface
cat > /etc/systemd/system/wpa_supplicant@$IFNAME.service <<EOF
[Unit]
Description=WPA supplicant for %i
Before=network.target

[Service]
ExecStart=/sbin/wpa_supplicant -i%i -c/etc/wpa_supplicant/wpa_supplicant-%i.conf
Restart=always

[Install]
WantedBy=multi-user.target
EOF

# Enable and start wpa_supplicant service for the interface
systemctl enable wpa_supplicant@$IFNAME
systemctl start wpa_supplicant@$IFNAME

# Create systemd-networkd configuration file for DHCP client
cat > /etc/systemd/network/$IFNAME.network <<EOF
[Match]
Name=$IFNAME

[Network]
DHCP=yes
EOF

# Restart systemd-networkd to apply the changes
systemctl enable systemd-networkd
systemctl restart systemd-networkd
