#!/bin/bash
set -e
set -x

SSID=$1
PASSWORD=$2
IFNAME=$3

if [ -z "$SSID" ]; then
    echo "SSID is required"
    exit 1
fi

if [ -z "$PASSWORD" ]; then
    echo "PASSWORD is required"
    exit 1
fi

if [ -z "$IFNAME" ]; then
    echo "IFNAME is required"
    exit 1
fi

# Stop any active hotspot or conflicting services
systemctl stop hostapd
systemctl stop dnsmasq

# Ensure the Wi-Fi interface is managed by NetworkManager
nmcli device set "$IFNAME" managed yes

# Add and connect to the Wi-Fi network
nmcli device wifi connect "$SSID" password "$PASSWORD" ifname "$IFNAME"
