#!/bin/bash
set -e
set -x

SSID=$1
PASSWORD=$2
IFNAME=$3

if [ -z "$SSID" ]; then
    echo "SSID is required"
    exit 1
fi

if [ -z "$PASSWORD" ]; then
    echo "PASSWORD is required"
    exit 1
fi

if [ -z "$IFNAME" ]; then
    echo "IFNAME is required"
    exit 1
fi

# Stop services that may conflict with Wi-Fi connection
systemctl stop hostapd
systemctl stop dnsmasq

# Disable the hotspot service if it's enabled
if systemctl is-active --quiet hotspot.service; then
    systemctl stop hotspot.service
    systemctl disable hotspot.service
fi

# Ensure the Wi-Fi interface is down before making changes
ip link set "$IFNAME" down || true

# Create the wpa_supplicant configuration file
WPA_CONF="/etc/wpa_supplicant/wpa_supplicant-${IFNAME}.conf"
cat <<EOF > "$WPA_CONF"
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=US

network={
    ssid="${SSID}"
    psk="${PASSWORD}"
    key_mgmt=WPA-PSK
}
EOF

# Reload the systemd configuration to ensure any changes are recognized
systemctl daemon-reload

# Start and enable the wpa_supplicant service for the specified interface
systemctl start wpa_supplicant@"${IFNAME}"
systemctl enable wpa_supplicant@"${IFNAME}"

# Bring the Wi-Fi interface up
ip link set "$IFNAME" up

# Ensure that systemd-networkd is configured to manage the interface
NETWORK_CONF="/etc/systemd/network/${IFNAME}.network"
cat <<EOF > "$NETWORK_CONF"
[Match]
Name=${IFNAME}

[Network]
DHCP=yes
EOF

# Restart systemd-networkd to apply the new configuration
systemctl restart systemd-networkd