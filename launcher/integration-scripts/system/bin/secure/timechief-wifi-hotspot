#!/bin/bash
set -e
set -x

SSID=$1
PASSWORD=$2
IFNAME=$3
AP_IP=$4
DHCP_RANGE=$5

if [ -z "$SSID" ]; then
    echo "SSID is required"
    exit 1
fi

if [ -z "$PASSWORD" ]; then
    echo "PASSWORD is required"
    exit 1
fi

if [ -z "$IFNAME" ]; then
    echo "IFNAME is required"
    exit 1
fi

if [ -z "$AP_IP" ]; then
    echo "AP_IP is required"
    exit 1
fi

if [ -z "$DHCP_RANGE" ]; then
    echo "DHCP_RANGE is required"
    exit 1
fi

# Stop services that might interfere
systemctl stop wpa_supplicant

# Create a new hotspot connection with nmcli
nmcli device set $IFNAME managed yes
nmcli connection add type wifi ifname $IFNAME mode ap con-name hotspot ssid "$SSID"
nmcli connection modify hotspot 802-11-wireless.mode ap 802-11-wireless.band bg ipv4.addresses $AP_IP/24 ipv4.method shared
nmcli connection modify hotspot wifi-sec.key-mgmt wpa-psk
nmcli connection modify hotspot wifi-sec.psk "$PASSWORD"

# Start the hotspot
nmcli connection up hotspot
