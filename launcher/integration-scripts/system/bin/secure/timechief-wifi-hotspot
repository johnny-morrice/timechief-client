#!/bin/bash
set -e
set -x

SSID=$1
PASSWORD=$2
IFNAME=$3
AP_IP=$4

if [ -z "$SSID" ]; then
    echo "SSID is required"
    exit 1
fi

if [ -z "$PASSWORD" ]; then
    echo "PASSWORD is required"
    exit 1
fi

if [ -z "$IFNAME" ]; then
    echo "IFNAME is required"
    exit 1
fi

if [ -z "$AP_IP" ]; then
    echo "AP_IP is required"
    exit 1
fi

set +e

# Check if a connection named "hotspot" exists and delete it
EXISTING_CONNECTIONS=$(nmcli -t -f NAME connection show | grep '^hotspot$')
if [ "$EXISTING_CONNECTIONS" ]; then
    nmcli connection down "hotspot"
    nmcli connection delete id "hotspot"
fi

set -e

sleep 0.5s

# Create a new hotspot connection with nmcli

nmcli device set "$IFNAME" managed yes
nmcli connection add type wifi ifname "$IFNAME" mode ap con-name hotspot ssid "$SSID"
nmcli connection modify hotspot 802-11-wireless.mode ap 802-11-wireless.band bg
nmcli connection modify hotspot ipv4.method manual ipv4.addresses "${AP_IP}/24"
nmcli connection modify hotspot wifi-sec.key-mgmt wpa-psk
nmcli connection modify hotspot wifi-sec.proto rsn
nmcli connection modify hotspot wifi-sec.psk "$PASSWORD"

NETWORK_PREFIX="${AP_IP%.*}"
cat <<EOF > /etc/dnsmasq.d/timechief-hotspot.conf
interface=$IFNAME
bind-interfaces
dhcp-range=${NETWORK_PREFIX}.2,${NETWORK_PREFIX}.100,24h
address=/#/$AP_IP
EOF

systemctl restart dnsmasq

# Start the hotspot
nmcli connection up hotspot
