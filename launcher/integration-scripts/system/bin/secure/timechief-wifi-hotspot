#!/bin/bash
set -e
set -x

SSID=$1
PASSWORD=$2
IFNAME=$3
AP_IP=$4
DHCP_RANGE=$5

if [ -z "$SSID" ]; then
    echo "SSID is required"
    exit 1
fi

if [ -z "$PASSWORD" ]; then
    echo "PASSWORD is required"
    exit 1
fi

if [ -z "$IFNAME" ]; then
    echo "IFNAME is required"
    exit 1
fi

if [ -z "$AP_IP" ]; then
    echo "AP_IP is required"
    exit 1
fi

if [ -z "$DHCP_RANGE" ]; then
    echo "DHCP_RANGE is required"
    exit 1
fi

# Stop and disable services that might interfere
systemctl stop systemd-networkd
systemctl stop wpa_supplicant

# Create systemd-networkd configuration for the interface
cat > /etc/systemd/network/$IFNAME.network <<EOF
[Match]
Name=$IFNAME

[Network]
Address=$AP_IP
DHCPServer=yes
EOF

# Restart systemd-networkd to apply the changes
systemctl enable systemd-networkd
systemctl restart systemd-networkd

# Create dnsmasq config file for DHCP service
cat > /etc/dnsmasq.d/hotspot.conf <<EOF
interface=$IFNAME
dhcp-range=$DHCP_RANGE
EOF

# Configure hostapd for the hotspot
cat > /etc/hostapd/hostapd.conf <<EOF
interface=$IFNAME
driver=nl80211
ssid=$SSID
hw_mode=g
channel=6
macaddr_acl=0
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_passphrase=$PASSWORD
wpa_key_mgmt=WPA-PSK
wpa_pairwise=TKIP
rsn_pairwise=CCMP
EOF

# Enable hostapd service
sed -i 's/^#DAEMON_CONF.*/DAEMON_CONF="\/etc\/hostapd\/hostapd.conf"/' /etc/default/hostapd
systemctl unmask hostapd
systemctl enable hostapd
systemctl restart hostapd

# Restart dnsmasq to apply the configuration
systemctl enable dnsmasq
systemctl restart dnsmasq
