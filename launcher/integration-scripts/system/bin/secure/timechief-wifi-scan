#!/usr/bin/python3
import sys
import subprocess
import json
import re

ifname = sys.argv[1]

# Command to scan WiFi networks using nmcli
cmd = ['nmcli', '-f', 'SSID,SIGNAL,SECURITY', 'device', 'wifi', 'list', 'ifname', ifname]

try:
    output = subprocess.check_output(cmd, stderr=subprocess.STDOUT).decode('utf-8')
except subprocess.CalledProcessError as e:
    print(e.output.decode('utf-8'))
    sys.exit(1)

networks = []

# Parse each line for SSID, Signal, and Security
for line in output.splitlines()[1:]:  # Skip the first line (header)
    fields = re.split(r'\s{2,}', line.strip())
    security = fields[2] if fields[2] else "Open"

    if len(fields) >= 3:
        network = {
            "SSID": fields[0],
            "Signal": int(fields[1]),
            "Security": security.split()
        }
        networks.append(network)

# Print output as JSON
print(json.dumps(networks, indent=4))