#!/usr/bin/python
import subprocess
import json
import sys

def connect_wifi(ssid, password, ifname):
    # Form the command to connect to the Wi-Fi network
    cmd = ['sudo', 'iwconfig', ifname, 'essid', ssid, 'key', password]

    # Execute the command and capture the output
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    out, err = proc.communicate()

    # Check if the connection was successful
    if err:
        return json.dumps({"Success": False, "Message": err.decode()})
    else:
        return json.dumps({"Success": True, "Message": out.decode()})

# Read the ssid, password, and ifname from the command line arguments
ssid = sys.argv[1]
password = sys.argv[2]
ifname = sys.argv[3]

# Call the connect_wifi function and print the result
result = connect_wifi(ssid, password, ifname)
print(result)